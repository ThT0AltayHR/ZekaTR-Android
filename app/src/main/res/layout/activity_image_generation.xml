<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:background="#0B0D10">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <ImageButton android:id="@+id/btnBack" android:layout_width="44dp" android:layout_height="44dp" android:src="@drawable/ic_back" android:background="@android:color/transparent" android:contentDescription="Geri" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="ZekaTR Görsel Atölyesi" android:textColor="#FFFFFF" android:textSize="21sp" android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="4K-ready" android:textColor="#9FE6C2" android:textStyle="bold" />
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Gerçekçi görsel üret, mevcut görseli düzenle. Çıktı kalitesi seçtiğin sağlayıcı ve modelin kapasitesine bağlıdır." android:textColor="#A9B0B8" />
    <ImageView android:id="@+id/preview" android:layout_width="match_parent" android:layout_height="220dp" android:layout_marginTop="14dp" android:scaleType="centerCrop" android:background="#15181D" android:contentDescription="Görsel önizleme" />
    <TextView android:id="@+id/textSelected" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#9AA2AC" android:paddingTop="6dp" />
    <EditText android:id="@+id/prompt" android:layout_width="match_parent" android:layout_height="110dp" android:layout_marginTop="8dp" android:gravity="top" android:hint="Örn. Sinematik, fotogerçekçi İstanbul gecesi…" android:textColor="#FFFFFF" android:hintTextColor="#68707A" android:background="@drawable/bg_input" android:padding="14dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp">
        <Spinner android:id="@+id/provider" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" />
        <Spinner android:id="@+id/size" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" />
        <Spinner android:id="@+id/quality" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" />
    </LinearLayout>
    <EditText android:id="@+id/model" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="6dp" android:hint="Görsel modeli" android:textColor="#FFFFFF" android:hintTextColor="#68707A" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp">
        <Button android:id="@+id/btnPick" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="Görsel seç" />
        <Button android:id="@+id/btnGenerate" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="Üret" />
        <Button android:id="@+id/btnEdit" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:text="Düzenle" />
    </LinearLayout>
    <ProgressBar android:id="@+id/progress" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:visibility="gone" android:layout_marginTop="8dp" />
    <TextView android:id="@+id/textStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Hazır" android:textColor="#A9B0B8" />
    <Button android:id="@+id/btnSave" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:text="Galeride kaydet" android:enabled="false" />
</LinearLayout>
